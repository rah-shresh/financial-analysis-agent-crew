# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored -- NEVER commit it or paste its contents anywhere public.

# MongoDB Atlas connection string. If your password has special characters
# (@ : / ? # %), URL-encode them (e.g. "@" -> "%40").
MONGODB_URI=
MONGODB_DB=

# Long random string used to sign login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# # Optional
# JWT_EXPIRE_MINUTES=1440
# FRONTEND_URL=http://localhost:5173
# MAX_CONCURRENT_RUNS=2
# # Set to false on small hosts: TensorFlow (LSTM) needs a lot of RAM. ARIMA still runs.
# ENABLE_LSTM=true
